{
  "name": "@topview/sidebar",
  "version": "2.4.2",
  "description": "Topview 通用侧边栏组件 - 基于 React, 依赖注入, 适配器模式",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./nextjs-adapter": {
      "types": "./dist/types/nextjs-adapter/index.d.ts",
      "import": "./dist/esm/nextjs-adapter/index.js",
      "require": "./dist/cjs/nextjs-adapter/index.js",
      "default": "./dist/esm/nextjs-adapter/index.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "react",
    "sidebar",
    "navigation",
    "next.js",
    "dependency-injection",
    "adapter-pattern"
  ],
  "author": "Topview Team",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://packages.aliyun.com/62e3495b1d343f24a18045bc/npm/npm-registry/",
    "access": "public"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.1"
  },
  "peerDependencies": {
    "@radix-ui/react-dialog": "^1.0.0",
    "@radix-ui/react-popover": "^1.1.0",
    "lucide-react": "^0.300.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@rollup/plugin-commonjs": "^25.0.8",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "rollup": "^4.57.1",
    "rollup-plugin-dts": "^6.3.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
